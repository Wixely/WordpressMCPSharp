{
  "//": "Sites are configured under Endpoints. Put real sites and credentials in WordpressMCPSharp.Local.json (gitignored), never in this checked-in file. Run wp_setup_probe with your site URL to generate the block, or wp_setup_instructions for the walkthrough.",
  "//Endpoints-example": {
    "site1": {
      "RestApi": {
        "BaseUrl": "https://example.com/",
        "Username": "admin",
        "ApplicationPassword": "xxxx xxxx xxxx xxxx xxxx xxxx",
        "AllowInvalidCertificate": false
      },
      "Ssh": {
        "Host": "web1.example.com",
        "Port": 22,
        "Username": "deploy",
        "PrivateKeyPath": "/home/user/.ssh/id_ed25519",
        "Path": "/var/www/example.com",
        "WpCliPath": "wp"
      }
    },
    "site2": {
      "RestApi": {
        "BaseUrl": "https://another.example.net/",
        "Username": "admin",
        "ApplicationPassword": "xxxx xxxx xxxx xxxx xxxx xxxx"
      },
      "ReadOnly": true
    }
  },
  "//Endpoints-example-management-only": {
    "clientsite": {
      "Docker": { "Container": "wordpress", "Path": "/var/www/html" },
      "Url": "https://clientsite.example.com/"
    }
  },
  "Endpoints": {},
  "Management": {
    "AllowCliManagement": false,
    "AllowArbitraryCli": false,
    "AllowProvisioning": false,
    "CommandTimeoutSeconds": 300,
    "LongCommandTimeoutSeconds": 1800,
    "SkipIdentityCheck": false,
    "DeniedCliCommands": [ "eval", "eval-file", "shell", "server" ]
  },
  "Snapshots": {
    "Directory": "",
    "MaxSnapshots": 10,
    "IncludeUploads": true,
    "AllowRestore": false
  },
  "Wordpress": {
    "ReadOnly": true,
    "AllowDelete": false,
    "AllowPluginInstall": false,
    "AllowRestPassthrough": false,
    "EnableWooCommerce": true,
    "EnableSiteHealth": true,
    "EnableContent": true,
    "EnableComments": true,
    "EnableUsers": true,
    "EnableTaxonomies": true,
    "EnablePlugins": true,
    "EnableThemes": true,
    "EnableSettings": true,
    "EnableMenus": true,
    "EnableSetupDiagnostics": true,
    "DownloadDirectory": null,
    "MaxInlineContentBytes": 65536,
    "MaxInlineBinaryBytes": 2000000,
    "DefaultPageSize": 20,
    "MaxPages": 5,
    "RequestTimeoutSeconds": 100,
    "UserAgent": "WordpressMCPSharp"
  },
  "Server": {
    "Host": "localhost",
    "Port": 5721,
    "Path": "/mcp",
    "WindowsServiceName": "WordpressMCPSharp",
    "Password": ""
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/wordpressmcp-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "fileSizeLimitBytes": 52428800,
          "rollOnFileSizeLimit": true,
          "shared": true,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithProcessId", "WithThreadId" ]
  }
}
